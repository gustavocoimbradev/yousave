{
  "name": "yousave",
  "version": "1.0.1",
  "description": "Baixe vídeos e áudios do YouTube com um clique.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "node scripts/fetch-win-bin.js",
    "build": "electron-builder --win",
    "publish": "git add . && git pull && git commit -m 'publish' && git push"
  },
  "license": "MIT",
  "author": "Gustavo Coimbra",
  "repository": {
    "type": "git",
    "url": "https://github.com/gustavocoimbradev/yousave.git"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "youtube-dl-exec": "^3.1.15"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.yousave.app",
    "productName": "YouSave",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/youtube-dl-exec/bin/**"
    ],
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json",
      "!node_modules/ffmpeg-static/ffmpeg",
      "!node_modules/ffmpeg-static/ffmpeg.LICENSE",
      "!node_modules/ffmpeg-static/ffmpeg.README",
      "!node_modules/youtube-dl-exec/bin/yt-dlp"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "gustavocoimbradev",
      "repo": "yousave"
    }
  }
}
